# Script mode: turn binary inputs into one C++ translation unit of byte arrays.
#
#   cmake -DOUTPUT=<file.cpp> "-DINPUTS=a;b" "-DSYMBOLS=x;y" -P embed_binary_resources.cmake

if(NOT DEFINED OUTPUT OR OUTPUT STREQUAL "")
    message(FATAL_ERROR "embed_binary_resources: OUTPUT is required.")
endif()
if(NOT DEFINED INPUTS OR NOT DEFINED SYMBOLS)
    message(FATAL_ERROR "embed_binary_resources: INPUTS and SYMBOLS are required.")
endif()

list(LENGTH INPUTS input_count)
list(LENGTH SYMBOLS symbol_count)
if(NOT input_count EQUAL symbol_count)
    message(FATAL_ERROR "embed_binary_resources: INPUTS and SYMBOLS must have the same length.")
endif()

set(generated "// Generated by embed_binary_resources.cmake. Do not edit.\n\n")
string(APPEND generated "#include <cstddef>\n#include <cstdint>\n\n")

if(input_count GREATER 0)
    math(EXPR last_index "${input_count} - 1")
    foreach(index RANGE ${last_index})
        list(GET INPUTS ${index} input)
        list(GET SYMBOLS ${index} symbol)

        if(NOT EXISTS "${input}")
            message(FATAL_ERROR "embed_binary_resources: '${input}' does not exist.")
        endif()

        file(READ "${input}" hex HEX)
        string(REGEX REPLACE "([0-9A-Fa-f][0-9A-Fa-f])" "0x\\1," bytes "${hex}")
        string(REPEAT "0x..," 16 row)
        string(REGEX REPLACE "(${row})" "\\1\n\t\t" bytes "${bytes}")
        string(LENGTH "${hex}" hex_length)
        math(EXPR length "${hex_length} / 2")

        string(APPEND generated
            "alignas(4) extern const unsigned char ${symbol}[] = {${bytes}};\n"
            "extern const std::size_t ${symbol}_size = ${length};\n\n")
    endforeach()
endif()

file(WRITE "${OUTPUT}" "${generated}")
