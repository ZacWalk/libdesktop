# libdesktop_add_app() — declares an application that uses the portable platform layer.
#
# The executable gets its Windows icon, manifest and version information from generated
# resources. EMBED data is registered with platform::register_embedded_resources and is
# available on every backend.
#
#   libdesktop_add_app(myapp
#       SOURCES     src/main.cpp src/document.cpp
#       ICON        src/res/myapp.ico
#       DESCRIPTION "My application"
#       OUTPUT_NAME myapp-64
#       EMBED       src/res/master.css src/res/test.htm)
#
# The function body runs in the caller's directory scope, so this has to be
# reachable from anywhere, not just from libdesktop's own scope.
set(LIBDESKTOP_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL "libdesktop cmake helpers")

function(libdesktop_add_app target)
    cmake_parse_arguments(LDA
        "CONSOLE"
        "ICON;MANIFEST;DESCRIPTION;OUTPUT_NAME;VERSION;COMPANY"
        "SOURCES;EMBED"
        ${ARGN})

    if(NOT LDA_SOURCES)
        message(FATAL_ERROR "libdesktop_add_app(${target}): SOURCES is required.")
    endif()

    set(generated_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}")
    file(MAKE_DIRECTORY "${generated_dir}")

    set(sources ${LDA_SOURCES})

    if(NOT LDA_VERSION)
        set(LDA_VERSION "${PROJECT_VERSION}")
    endif()
    if(NOT LDA_VERSION)
        set(LDA_VERSION "0.0.0.0")
    endif()
    if(NOT LDA_OUTPUT_NAME)
        set(LDA_OUTPUT_NAME "${target}")
    endif()
    if(NOT LDA_DESCRIPTION)
        set(LDA_DESCRIPTION "${target}")
    endif()

    # --- embedded data files -------------------------------------------------
    if(LDA_EMBED)
        set(embed_inputs "")
        set(embed_names "")
        foreach(item IN LISTS LDA_EMBED)
            get_filename_component(absolute "${item}" ABSOLUTE)
            get_filename_component(name "${item}" NAME)
            list(APPEND embed_inputs "${absolute}")
            list(APPEND embed_names "${name}")
        endforeach()

        set(embed_cpp "${generated_dir}/embedded_resources.cpp")
        add_custom_command(
            OUTPUT "${embed_cpp}"
            COMMAND "${CMAKE_COMMAND}"
                    "-DOUTPUT=${embed_cpp}"
                    "-DINPUTS=${embed_inputs}"
                    "-DNAMES=${embed_names}"
                    "-DREGISTRY_NAMESPACE=platform"
                    -P "${LIBDESKTOP_CMAKE_DIR}/embed_resources.cmake"
            DEPENDS ${embed_inputs} "${LIBDESKTOP_CMAKE_DIR}/embed_resources.cmake"
            COMMENT "Embedding ${target} resources"
            VERBATIM)

        list(APPEND sources "${embed_cpp}")
        set_source_files_properties("${embed_cpp}" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
    endif()

    if(WIN32)
        # --- manifest --------------------------------------------------------
        if(NOT DEFINED LDA_MANIFEST)
            set(PLATFORM_APP_NAME "${LDA_OUTPUT_NAME}.exe")
            set(PLATFORM_APP_VERSION "${LDA_VERSION}")
            if(NOT PLATFORM_APP_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$")
                set(PLATFORM_APP_VERSION "${PLATFORM_APP_VERSION}.0")
            endif()
            set(PLATFORM_APP_DESCRIPTION "${LDA_DESCRIPTION}")

            set(manifest "${generated_dir}/${target}.manifest")
            configure_file("${LIBDESKTOP_CMAKE_DIR}/app.manifest.in" "${manifest}" @ONLY)
            list(APPEND sources "${manifest}")
        elseif(NOT LDA_MANIFEST STREQUAL "NONE")
            list(APPEND sources "${LDA_MANIFEST}")
        endif()

        # --- generated resource script ---------------------------------------
        string(REPLACE "." "," rc_version "${LDA_VERSION}")
        string(REGEX REPLACE "^([0-9]+,[0-9]+,[0-9]+)$" "\\1,0" rc_version "${rc_version}")

        set(rc "// Generated by libdesktop_add_app(). Do not edit.\n#include <windows.h>\n\n")

        if(LDA_ICON)
            get_filename_component(icon_path "${LDA_ICON}" ABSOLUTE)
            if(NOT EXISTS "${icon_path}")
                message(FATAL_ERROR "libdesktop_add_app(${target}): ICON '${icon_path}' does not exist.")
            endif()
            file(TO_NATIVE_PATH "${icon_path}" icon_native)
            string(REPLACE "\\" "\\\\" icon_native "${icon_native}")
            # ID 1: the lowest icon ID is the one the shell shows for the exe.
            string(APPEND rc "1 ICON \"${icon_native}\"\n\n")
        endif()

        string(APPEND rc "VS_VERSION_INFO VERSIONINFO\n")
        string(APPEND rc " FILEVERSION ${rc_version}\n PRODUCTVERSION ${rc_version}\n")
        string(APPEND rc " FILEFLAGSMASK 0x3fL\n FILEFLAGS 0x0L\n FILEOS VOS_NT_WINDOWS32\n")
        string(APPEND rc " FILETYPE VFT_APP\n FILESUBTYPE VFT2_UNKNOWN\nBEGIN\n")
        string(APPEND rc "  BLOCK \"StringFileInfo\"\n  BEGIN\n    BLOCK \"040904b0\"\n    BEGIN\n")
        string(APPEND rc "      VALUE \"FileDescription\", \"${LDA_DESCRIPTION}\"\n")
        string(APPEND rc "      VALUE \"FileVersion\", \"${LDA_VERSION}\"\n")
        string(APPEND rc "      VALUE \"InternalName\", \"${target}\"\n")
        string(APPEND rc "      VALUE \"OriginalFilename\", \"${LDA_OUTPUT_NAME}.exe\"\n")
        string(APPEND rc "      VALUE \"ProductName\", \"${target}\"\n")
        string(APPEND rc "      VALUE \"ProductVersion\", \"${LDA_VERSION}\"\n")
        if(LDA_COMPANY)
            string(APPEND rc "      VALUE \"CompanyName\", \"${LDA_COMPANY}\"\n")
        endif()
        string(APPEND rc "    END\n  END\n  BLOCK \"VarFileInfo\"\n  BEGIN\n")
        string(APPEND rc "    VALUE \"Translation\", 0x409, 1200\n  END\nEND\n")

        set(rc_file "${generated_dir}/${target}.rc")
        file(GENERATE OUTPUT "${rc_file}" CONTENT "${rc}")
        list(APPEND sources "${rc_file}")
    endif()

    if(LDA_CONSOLE OR NOT WIN32)
        add_executable(${target} ${sources})
    else()
        add_executable(${target} WIN32 ${sources})
        target_link_options(${target} PRIVATE "/ENTRY:mainCRTStartup")
    endif()

    target_link_libraries(${target} PRIVATE libdesktop::platform)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${LDA_OUTPUT_NAME}")
endfunction()
